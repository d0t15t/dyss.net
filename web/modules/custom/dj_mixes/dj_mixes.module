<?php

/**
 * @file
 * Provides the DJ Mix content type's track-row rendering and playback wiring.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Htmx\Htmx;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\dj_mixes\DjMixPager;
use Drupal\image\Entity\ImageStyle;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 *
 * Drupal's static theme registry only associates a template *file* with a
 * hook suggestion name (e.g. media--mp3--track-row.html.twig with
 * "media__mp3__track_row") if that suggestion name already exists in the
 * registry cache when it scans the templates directory
 * (see drupal_find_theme_templates()). Runtime suggestions from
 * hook_theme_suggestions_media() alone are not enough for a *new* template
 * file to be discovered - the suggestion has to be pre-declared here too.
 */
function dj_mixes_theme() {
  return [
    'media__mp3__track_row' => [
      'base hook' => 'media',
    ],
    'dj_mix_pager' => [
      'variables' => [
        'cards' => [],
        'previous' => NULL,
        'next' => NULL,
        'listing' => NULL,
        'position' => 0,
        'total' => 0,
        'filtered' => FALSE,
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_media__mp3__track_row().
 *
 * Builds the `track` variable the media--mp3--track-row.html.twig template
 * uses to render a play button, without duplicating what the already
 * -configured field formatters in the track_row view mode do for the rest
 * of the row (title, artist, album, etc. still come from {{ content }}).
 */
function dj_mixes_preprocess_media__mp3__track_row(array &$variables) {
  /** @var \Drupal\media\MediaInterface $media */
  $media = $variables['elements']['#media'];

  $file = $media->hasField('field_media_mp3_file') && !$media->get('field_media_mp3_file')->isEmpty()
    ? $media->get('field_media_mp3_file')->entity
    : NULL;
  $cover = $media->hasField('field_cover_art') && !$media->get('field_cover_art')->isEmpty()
    ? $media->get('field_cover_art')->entity
    : NULL;

  $cover_url = '';
  if ($cover) {
    $style = ImageStyle::load('thumbnail');
    $cover_url = $style
      ? $style->buildUrl($cover->getFileUri())
      : \Drupal::service('file_url_generator')->generateAbsoluteString($cover->getFileUri());
  }

  $variables['track'] = [
    'media_id' => $media->id(),
    'title' => $media->label(),
    'artist' => $media->hasField('field_artist') ? $media->get('field_artist')->value : '',
    'album' => $media->hasField('field_album') ? $media->get('field_album')->value : '',
    'src' => $file ? \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri()) : '',
    'cover_url' => $cover_url,
  ];

  $variables['#attached']['library'][] = 'dj_mixes/track-buttons';
}

/**
 * The listing parameters for a DJ mix rendered in a listing view mode.
 *
 * The pager block sets "#dj_mix_query" on its cards; elsewhere (the listing
 * itself) the parameters come from the current URL.
 */
function _dj_mixes_listing_query(array $element): array {
  if (isset($element['#dj_mix_query'])) {
    return $element['#dj_mix_query'];
  }
  return \Drupal::service(DjMixPager::class)->parameters(\Drupal::request());
}

/**
 * Implements hook_entity_build_defaults_alter().
 *
 * Teasers and cards link with the listing parameters in the URL, so their
 * render cache varies by them.
 */
function dj_mixes_entity_build_defaults_alter(array &$build, EntityInterface $entity, $view_mode) {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'dj_mix' && in_array($view_mode, DjMixPager::LINK_VIEW_MODES, TRUE)) {
    foreach (\Drupal::service(DjMixPager::class)->parameterNames() as $name) {
      $build['#cache']['contexts'][] = 'url.query_args:' . $name;
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for node.
 *
 * Passes the listing parameters on in the cover image link.
 */
function dj_mixes_node_view_alter(array &$build, NodeInterface $node, EntityViewDisplayInterface $display) {
  if ($node->bundle() !== 'dj_mix' || !in_array($display->getMode(), DjMixPager::LINK_VIEW_MODES, TRUE)) {
    return;
  }
  $query = _dj_mixes_listing_query($build);
  if (!$query || empty($build['field_cover_image'])) {
    return;
  }
  foreach (Element::children($build['field_cover_image']) as $delta) {
    if (isset($build['field_cover_image'][$delta]['#url'])) {
      $build['field_cover_image'][$delta]['#url']->setOption('query', $query);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for node.
 *
 * Passes the listing parameters on in the title link.
 */
function dj_mixes_preprocess_node(array &$variables) {
  $node = $variables['node'];
  if ($node->bundle() !== 'dj_mix' || !in_array($variables['view_mode'], DjMixPager::LINK_VIEW_MODES, TRUE)) {
    return;
  }
  if ($query = _dj_mixes_listing_query($variables['elements'])) {
    $variables['url'] = $node->toUrl('canonical', ['query' => $query])->toString();
  }
}

/**
 * Whether a view is the DJ mixes listing.
 */
function _dj_mixes_is_listing(ViewExecutable $view): bool {
  return $view->id() === DjMixPager::VIEW && $view->current_display === DjMixPager::DISPLAY;
}

/**
 * Implements hook_views_pre_render().
 */
function dj_mixes_views_pre_render(ViewExecutable $view) {
  if (_dj_mixes_is_listing($view)) {
    $view->element['#attached']['library'][] = 'core/drupal.htmx';
    $view->element['#attached']['library'][] = 'dj_mixes/listing';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_unformatted.
 *
 * Infinite scroll on the DJ mixes listing (htmx): when a teaser near the end
 * of the page is scrolled into view, the next page of the listing - with the
 * same filters - is requested as main content only, and its teasers are
 * appended to this page. Each page carries the trigger for the next one; the
 * last page has none. Without JavaScript the regular pager stays in use.
 */
function dj_mixes_preprocess_views_view_unformatted(array &$variables) {
  $view = $variables['view'];
  if (!_dj_mixes_is_listing($view) || empty($variables['rows']) || !$view->pager) {
    return;
  }
  // Only the listing's own parameters: htmx adds internal ones to the
  // request.
  $query = DjMixPager::nextPageQuery(
    \Drupal::service(DjMixPager::class)->parameters(\Drupal::request()),
    (int) $view->getCurrentPage(),
    (int) $view->pager->getItemsPerPage(),
    (int) $view->pager->getTotalItems(),
  );
  if ($query === NULL) {
    return;
  }
  $url = Url::fromRoute('view.' . DjMixPager::VIEW . '.' . DjMixPager::DISPLAY, [], ['query' => $query]);

  $htmx = new Htmx();
  $htmx->get($url)
    ->onlyMainContent()
    ->trigger('revealed')
    ->select('.view-id-' . DjMixPager::VIEW . ' .view-content > .views-row')
    ->target('closest .view-content')
    ->swap('beforeend');

  $keys = array_keys($variables['rows']);
  $trigger = $keys[max(0, count($keys) - DjMixPager::SCROLL_PREFETCH)];
  $variables['rows'][$trigger]['attributes']->merge($htmx->getAttributes());
}
