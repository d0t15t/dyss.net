msgctxt "Contact form"
msgid "Message"
msgstr "Nachricht"

msgid "Leave this field empty"
msgstr "Dieses Feld leer lassen"

msgid "Please keep your message under @count characters."
msgstr "Bitte halte deine Nachricht unter @count Zeichen."

msgid "You have sent several messages in a short time. Please try again later."
msgstr "Du hast in kurzer Zeit mehrere Nachrichten gesendet. Bitte versuche es später noch einmal."

