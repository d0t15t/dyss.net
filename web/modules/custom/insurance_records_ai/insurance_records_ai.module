<?php

/**
 * @file
 * Readable search filters for the insurance AI answer.
 */

use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_ai_assistant_ui_search_context_alter().
 *
 * The AI answer on /insurance/search receives the active facets as "Facet:
 * raw value" lines. Document types arrive as machine names; show their
 * labels instead so the assistant reads "Document type: Annual statement".
 */
function insurance_records_ai_ai_assistant_ui_search_context_alter(array &$context, array $settings): void {
  if (($settings['ai_assistant'] ?? '') !== 'insurance_search') {
    return;
  }
  $labels = FieldStorageConfig::loadByName('media', 'field_document_type')?->getSetting('allowed_values') ?? [];
  foreach ($context['filters'] as &$filter) {
    if (preg_match('/^Document type: (\S+)$/', $filter, $m) && isset($labels[$m[1]])) {
      $filter = 'Document type: ' . $labels[$m[1]];
    }
  }
}
