<?php

/**
 * @file
 * A persistent media player.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function persistent_player_help($route_name, RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.persistent_player') {
    $output = '<p>' . t('The Persistent Player module provides a single, page-wide media player that keeps playing while the visitor navigates to other pages, as the htmx navigation module only swaps the content area of a page. It plays MP3s and, through backends other modules add, embeddable media such as Mixcloud shows.') . '</p>';
    $output .= '<p>' . t('See the README.md file included with this module for the JavaScript API (<code>Drupal.persistentPlayer</code>), backends and the <code>persistentplayer:*</code> events.') . '</p>';
    return $output;
  }
  return NULL;
}

/**
 * Implements hook_theme().
 */
function persistent_player_theme() {
  return [
    'persistent_player' => [
      'variables' => [],
    ],
  ];
}
