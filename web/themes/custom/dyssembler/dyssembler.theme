<?php

/**
 * @file
 * Theme hooks for Dyssembler.
 */

/**
 * Implements hook_page_attachments_alter().
 *
 * The favicon itself is favicon.svg, set in the theme settings. Safari and
 * home screen shortcuts want a PNG instead.
 */
function dyssembler_page_attachments_alter(array &$attachments) {
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'apple-touch-icon',
      'href' => base_path() . \Drupal::service('extension.list.theme')->getPath('dyssembler') . '/apple-touch-icon.png',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for links__language_block.
 *
 * The language switcher shows language codes ("EN", "DE"), with the native
 * language names for screen readers. It switches with a full page load: the
 * header, menus and footer are outside the area htmx navigation replaces.
 */
function dyssembler_preprocess_links__language_block(array &$variables) {
  $names = \Drupal::languageManager()->getStandardLanguageList();
  foreach ($variables['links'] as $langcode => &$item) {
    if (!isset($item['link'])) {
      continue;
    }
    $item['link']['#title'] = strtoupper($langcode);
    $item['link']['#options']['attributes']['lang'] = $langcode;
    $item['link']['#options']['attributes']['aria-label'] = $names[$langcode][1] ?? $langcode;
  }
  $variables['attributes']['class'][] = 'language-switcher';
  $variables['attributes']['data-no-htmx-navigation'] = '';
}
